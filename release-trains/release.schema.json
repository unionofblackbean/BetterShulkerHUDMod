{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Better Shulker HUD release train",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "train", "title", "prerelease", "versions", "notesFile"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "train": { "type": "string", "pattern": "^release-[0-9]{4}\\.[0-9]{2}-r[0-9]+(?:-beta\\.[0-9]+)?$" },
    "title": { "type": "string", "pattern": "^\\[MC [^\\]]+\\]\\[Mod [^\\]]+\\] .+" },
    "prerelease": { "type": "boolean" },
    "versions": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "notesFile": { "type": "string" },
    "includeManifest": { "type": "boolean", "default": true }
  }
}
