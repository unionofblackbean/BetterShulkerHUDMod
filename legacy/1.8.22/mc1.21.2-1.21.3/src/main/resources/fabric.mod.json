{
  "schemaVersion": 1,
  "id": "better-shulker-hud",
  "version": "${version}",
  "name": "Better Shulker HUD",
  "description": "Preview, search, sort and manage items stored in carried shulker boxes. Supports QuickShulker extraction, source-aware returns, Pinyin search and Litematica Easy Place restocking.",
  "authors": [
    "BF_skt"
  ],
  "contributors": [
    "zeroowo24 - original BetterBundleHUD author and HUD design reference"
  ],
  "contact": {
    "homepage": "https://github.com/unionofblackbean/BetterShulkerHUDMod",
    "sources": "https://github.com/unionofblackbean/BetterShulkerHUDMod",
    "issues": "https://github.com/unionofblackbean/BetterShulkerHUDMod/issues"
  },
  "license": "CC0-1.0",
  "environment": "client",
  "entrypoints": {
    "main": [
      "bettershulkerhud.BetterBundleMod"
    ],
    "rei_client": [
      "bettershulkerhud.compat.ReiExclusionPlugin"
    ]
  },
  "accessWidener": "better-shulker-hud.accesswidener",
  "mixins": [
    {
      "config": "better-shulker-hud.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "fabric-api": "*",
    "malilib": ">=0.22.0 <0.23.0",
    "quickshulker": [
      ">=2.1.0-1.21.2 <=2.1.3-1.21.2",
      ">=3.0.0-1.21.2 <=3.0.1-1.21.2",
      ">=2.2.0-1.21.3 <=2.2.3-1.21.3",
      ">=3.0.0-1.21.3 <=3.0.1-1.21.3"
    ],
    "minecraft": ">=1.21.2 <=1.21.3",
    "java": ">=21"
  },
  "suggests": {
    "litematica": "*",
    "roughlyenoughitems": ">=16.0.0"
  }
}
